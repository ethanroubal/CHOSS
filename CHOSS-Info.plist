<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the generated Info.plist (GENERATE_INFOPLIST_FILE). Values come from the
	     ADMOB_* build settings in the project, so test and real IDs are set in one place. -->
	<!-- The app's green accent. The asset catalog normally adds this to the generated plist, but
	     with a plist file of our own it went missing and controls turned system blue. -->
	<!-- Opens the app from links back to it, e.g. the password-reset email
	     (com.choss.app://reset-password). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.choss.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.choss.app</string>
			</array>
		</dict>
	</array>
	<key>NSAccentColorName</key>
	<string>AccentColor</string>
	<key>GADApplicationIdentifier</key>
	<string>$(ADMOB_APP_ID)</string>
	<key>CHOSSAppOpenAdUnitID</key>
	<string>$(ADMOB_APP_OPEN_AD_UNIT_ID)</string>
	<key>CHOSSFeedNativeAdUnitID</key>
	<string>$(ADMOB_FEED_NATIVE_AD_UNIT_ID)</string>
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
	</array>
</dict>
</plist>
